+    #[gpui::test]
+    fn copy_targets_the_turn_under_the_overlay(cx: &mut gpui::TestAppContext) {
+        cx.update(|cx| {
+            // [User 0, Agent 1, User 2, Agent 3]
+            let entries = conversation_entries(cx);
+
+            assert_eq!(ThreadView::turn_copy_target(&entries, 3), Some(3));
+            assert_eq!(ThreadView::turn_copy_target(&entries, 1), Some(1));
+            // Over a user message, the response just above it is the one read.
+            assert_eq!(ThreadView::turn_copy_target(&entries, 2), Some(1));
+            // Nothing above the first message, so there is no response to copy.
+            assert_eq!(ThreadView::turn_copy_target(&entries, 0), None);
+            assert_eq!(ThreadView::turn_copy_target(&entries, 4), None);
+
+            // An unanswered prompt at the bottom copies the response above it;
+            // a thread with no response at all has nothing to copy.
+            let unanswered = &entries[..3];
+            assert_eq!(ThreadView::turn_copy_target(unanswered, 2), Some(1));
+            assert_eq!(ThreadView::turn_copy_target(&entries[..1], 0), None);
+
+            let copied = ThreadView::get_agent_message_content(&entries, 1, cx)
+                .expect("the targeted turn has a response");
+            assert!(copied.contains("Result<Args"), "{copied:?}");
+            assert!(!copied.contains("Documented"), "{copied:?}");
+        });
+    }
