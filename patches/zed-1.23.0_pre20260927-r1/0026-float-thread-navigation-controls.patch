+    /// The thread's navigation controls, as a fixed overlay on the conversation
+    /// instead of a row inside the last entry.
+    ///
+    /// `render_thread_controls` renders *inside* a list item, so the moment the
+    /// turn it belongs to scrolls out of view its controls go with it --
+    /// precisely when these start being useful. Anchoring them on the
+    /// conversation container keeps them reachable from anywhere in the thread.
+    ///
+    /// Two of them are relative to the scroll position rather than to the
+    /// thread's ends, which is what lets a fixed control say which turn it
+    /// means: copy acts on the turn the overlay sits over, and the user-message
+    /// button walks back one message per click.
+    fn render_floating_thread_navigation(&self, cx: &Context<Self>) -> impl IntoElement {
+        let entries = self.thread.read(cx).entries();
+
+        let previous_user_message =
+            Self::previous_user_message_ix(entries, self.list_state.logical_scroll_top());
+
+        // A turn still being written is disabled rather than hidden: copying it
+        // would hand over a partial response, and a button that comes and goes
+        // with the agent's status reads as a layout glitch.
+        let copy_target = self.entry_ix_at_viewport_bottom().and_then(|ix| {
+            let target = Self::turn_copy_target(entries, ix)?;
+            let is_last_turn = !entries
+                .iter()
+                .skip(target + 1)
+                .any(|entry| matches!(entry, AgentThreadEntry::UserMessage(_)));
+            (!is_last_turn || !self.is_last_turn_in_progress(cx)).then_some(target)
+        });
+
+        div()
+            .absolute()
+            // Clear of the vertical scrollbar the same container draws.
+            .right_4()
+            .bottom_2()
+            .child(
+                h_flex()
+                    .gap_0p5()
+                    .p_0p5()
+                    .rounded_md()
+                    .border_1()
+                    .border_color(cx.theme().colors().border)
+                    .bg(cx.theme().colors().elevated_surface_background)
+                    .opacity(0.4)
+                    .hover(|s| s.opacity(1.))
+                    .child(
+                        IconButton::new("floating_copy_agent_response", IconName::Copy)
+                            .icon_size(IconSize::Small)
+                            .icon_color(Color::Muted)
+                            .disabled(copy_target.is_none())
+                            .tooltip(Tooltip::text("Copy This Agent Response"))
+                            .on_click(cx.listener(move |this, _, _, cx| {
+                                let Some(target) = copy_target else {
+                                    return;
+                                };
+                                let entries = this.thread.read(cx).entries();
+                                if let Some(text) =
+                                    Self::get_agent_message_content(entries, target, cx)
+                                {
+                                    cx.write_to_clipboard(ClipboardItem::new_string(text));
+                                }
+                            })),
+                    )
+                    .child(
+                        IconButton::new(
+                            "floating_scroll_to_previous_user_message",
+                            IconName::UserArrowUp,
+                        )
+                        .icon_size(IconSize::Small)
+                        .icon_color(Color::Muted)
+                        .disabled(previous_user_message.is_none())
+                        .tooltip(Tooltip::text("Scroll to Previous User Message"))
+                        .on_click(cx.listener(move |this, _, _, cx| {
+                            if let Some(ix) = previous_user_message {
+                                this.scroll_to_user_message_index(Some(ix), cx);
+                            }
+                        })),
+                    )
+                    .child(
+                        IconButton::new("floating_scroll_to_top", IconName::ArrowUp)
+                            .icon_size(IconSize::Small)
+                            .icon_color(Color::Muted)
+                            .tooltip(Tooltip::text("Scroll to Top"))
+                            .on_click(cx.listener(|this, _, _, cx| {
