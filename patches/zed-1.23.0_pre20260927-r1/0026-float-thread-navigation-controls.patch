+    fn is_last_turn_in_progress(&self, cx: &App) -> bool {
+        let thread = self.thread.read(cx);
+        matches!(thread.status(), ThreadStatus::Generating)
+            || thread.is_waiting_for_confirmation()
+            || self.has_pending_request_elicitation(cx)
+    }
+
+    /// The user message the "previous" control should land on.
+    ///
+    /// It is measured from the scroll position, not from a click counter, so
+    /// repeated clicks walk back one message each -- every landing puts that
+    /// message at the top, and the next search starts above it -- and a manual
+    /// scroll in between is honoured instead of fought. A user message that is
+    /// already partly scrolled past counts as the one to return to.
+    fn previous_user_message_ix(
+        entries: &[AgentThreadEntry],
+        scroll_top: ListOffset,
+    ) -> Option<usize> {
+        let is_user_message =
+            |ix: usize| matches!(entries.get(ix), Some(AgentThreadEntry::UserMessage(_)));
+
+        if scroll_top.offset_in_item > px(0.) && is_user_message(scroll_top.item_ix) {
+            return Some(scroll_top.item_ix);
+        }
+        (0..scroll_top.item_ix.min(entries.len()))
+            .rev()
+            .find(|&ix| is_user_message(ix))
+    }
+
+    /// The entry the floating overlay sits over, i.e. the last one whose top
+    /// is above the viewport's bottom edge.
+    fn entry_ix_at_viewport_bottom(&self) -> Option<usize> {
+        let item_count = self.list_state.item_count();
+        if item_count == 0 {
+            return None;
+        }
+        let viewport_bottom = self.list_state.viewport_bounds().bottom();
+        let mut ix = self.list_state.logical_scroll_top().item_ix.min(item_count - 1);
+        while ix + 1 < item_count {
+            match self.list_state.bounds_for_item(ix) {
+                Some(bounds) if bounds.bottom() < viewport_bottom => ix += 1,
+                _ => break,
+            }
+        }
+        Some(ix)
+    }
+
+    /// The entry whose turn the copy control acts on, given the entry under
+    /// the overlay, or `None` when that turn has no agent response.
+    ///
+    /// Over a user message the overlay sits right below the end of the
+    /// previous turn, which is the response just read, so that turn is the
+    /// one copied rather than the reply that has not scrolled into view yet.
+    fn turn_copy_target(entries: &[AgentThreadEntry], ix: usize) -> Option<usize> {
+        let target = match entries.get(ix)? {
+            AgentThreadEntry::UserMessage(_) => ix.checked_sub(1)?,
+            _ => ix,
+        };
+        let is_user_message =
+            |ix: &usize| matches!(entries.get(*ix), Some(AgentThreadEntry::UserMessage(_)));
+        let start = (0..target)
+            .rev()
+            .find(is_user_message)
+            .map_or(0, |ix| ix + 1);
+        let end = (target..entries.len())
+            .find(is_user_message)
+            .unwrap_or(entries.len());
+        entries
+            .get(start..end)?
+            .iter()
+            .any(|entry| matches!(entry, AgentThreadEntry::AssistantMessage(_)))
+            .then_some(target)
+    }
