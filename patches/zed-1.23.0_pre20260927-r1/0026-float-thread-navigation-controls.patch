+    #[gpui::test]
+    fn previous_user_message_walks_back_one_message_per_click(cx: &mut gpui::TestAppContext) {
+        cx.update(|cx| {
+            // [User 0, Agent 1, User 2, Agent 3]
+            let entries = conversation_entries(cx);
+            let at = |item_ix: usize, offset: f32| ListOffset {
+                item_ix,
+                offset_in_item: px(offset),
+            };
+
+            // Reading the last response: the first click goes to the last message.
+            assert_eq!(
+                ThreadView::previous_user_message_ix(&entries, at(3, 40.)),
+                Some(2)
+            );
+            // Landed on it: the next click goes one further back, not to it again.
+            assert_eq!(
+                ThreadView::previous_user_message_ix(&entries, at(2, 0.)),
+                Some(0)
+            );
+            // Partly scrolled past a user message: return to that one first.
+            assert_eq!(
+                ThreadView::previous_user_message_ix(&entries, at(2, 10.)),
+                Some(2)
+            );
+            // Already on the first message: nothing earlier, so the button disables.
+            assert_eq!(
+                ThreadView::previous_user_message_ix(&entries, at(0, 0.)),
+                None
+            );
+            assert_eq!(ThreadView::previous_user_message_ix(&[], at(0, 0.)), None);
+        });
+    }
