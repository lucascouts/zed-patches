+    #[gpui::test]
+    fn test_parse_agent_url_with_session(cx: &mut TestAppContext) {
+        let request = cx.update(|cx| {
+            OpenRequest::parse(
+                RawOpenRequest {
+                    urls: vec!["zed://agent?session=abc-123".into()],
+                    ..Default::default()
+                },
+                cx,
+            )
+            .unwrap()
+        });
+
+        match request.kind {
+            Some(OpenRequestKind::AgentPanel {
+                session_id,
+                external_source_prompt,
+            }) => {
+                assert_eq!(session_id.as_ref().map(|id| id.0.as_ref()), Some("abc-123"));
+                assert_eq!(external_source_prompt, None);
+            }
+            _ => panic!("Expected AgentPanel kind"),
+        }
+    }
+
+    /// A link that names a thread is asking for that thread. Seeding a prompt
+    /// into it would put words into a conversation the user reopened to read.
+    #[gpui::test]
+    fn test_parse_agent_url_session_wins_over_prompt(cx: &mut TestAppContext) {
+        let request = cx.update(|cx| {
+            OpenRequest::parse(
+                RawOpenRequest {
+                    urls: vec!["zed://agent?session=abc-123&prompt=hello".into()],
+                    ..Default::default()
+                },
+                cx,
+            )
+            .unwrap()
+        });
+
+        match request.kind {
+            Some(OpenRequestKind::AgentPanel {
+                session_id,
+                external_source_prompt,
+            }) => {
+                assert_eq!(session_id.as_ref().map(|id| id.0.as_ref()), Some("abc-123"));
+                assert_eq!(external_source_prompt, None);
+            }
+            _ => panic!("Expected AgentPanel kind"),
+        }
+    }
+
+    /// An empty value is not a session: it would resolve to no thread and
+    /// silently swallow a prompt that was also supplied.
+    #[gpui::test]
+    fn test_parse_agent_url_with_empty_session(cx: &mut TestAppContext) {
+        let request = cx.update(|cx| {
+            OpenRequest::parse(
+                RawOpenRequest {
+                    urls: vec!["zed://agent?session=&prompt=hello".into()],
+                    ..Default::default()
+                },
+                cx,
+            )
+            .unwrap()
+        });
+
+        match request.kind {
+            Some(OpenRequestKind::AgentPanel {
+                session_id,
+                external_source_prompt,
+            }) => {
+                assert_eq!(session_id, None);
+                assert_eq!(
+                    external_source_prompt
+                        .as_ref()
+                        .map(ExternalSourcePrompt::as_str),
+                    Some("hello")
+                );
+            }
+            _ => panic!("Expected AgentPanel kind"),
+        }
+    }
+
