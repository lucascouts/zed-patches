 crates/zed/src/main.rs              |  21 +++--
 crates/zed/src/zed/open_listener.rs | 127 ++++++++++++++++++++++++++--
 2 files changed, 138 insertions(+), 10 deletions(-)

diff --git a/crates/zed/src/main.rs b/crates/zed/src/main.rs
index ec31980..da28f89 100644
--- a/crates/zed/src/main.rs
+++ b/crates/zed/src/main.rs
@@ -1039,6 +1039,7 @@ fn handle_open_request(request: OpenRequest, app_state: Arc<AppState>, cx: &mut
             }
             OpenRequestKind::AgentPanel {
                 external_source_prompt,
+                session_id,
             } => {
                 cx.spawn(async move |cx| {
                     let multi_workspace =
@@ -1057,11 +1058,21 @@ fn handle_open_request(request: OpenRequest, app_state: Arc<AppState>, cx: &mut
                         multi_workspace.workspace().update(cx, |workspace, cx| {
                             if let Some(panel) = workspace.focus_panel::<AgentPanel>(window, cx) {
                                 panel.update(cx, |panel, cx| {
-                                    panel.new_agent_thread_with_external_source_prompt(
-                                        external_source_prompt,
-                                        window,
-                                        cx,
-                                    );
+                                    // A session id reopens that thread; everything
+                                    // else starts a new one. open_thread already
+                                    // resolves the id against ThreadMetadataStore
+                                    // and falls back to loading the session when
+                                    // this machine has no row for it, so an id from
+                                    // another host is not an error here.
+                                    if let Some(session_id) = session_id {
+                                        panel.open_thread(session_id, None, None, window, cx);
+                                    } else {
+                                        panel.new_agent_thread_with_external_source_prompt(
+                                            external_source_prompt,
+                                            window,
+                                            cx,
+                                        );
+                                    }
                                 });
                             } else {
                                 log::warn!(
diff --git a/crates/zed/src/zed/open_listener.rs b/crates/zed/src/zed/open_listener.rs
index 0675fdd..09ac1d5 100644
--- a/crates/zed/src/zed/open_listener.rs
+++ b/crates/zed/src/zed/open_listener.rs
@@ -1,5 +1,6 @@
 use crate::handle_open_request;
 use crate::restore_or_create_workspace;
+use agent_client_protocol::schema::v1 as acp;
 use agent_ui::ExternalSourcePrompt;
 use anyhow::{Context as _, Result, anyhow};
 use cli::{CliRequest, CliResponse, CliResponseSink};
@@ -59,6 +60,14 @@ pub enum OpenRequestKind {
     },
     AgentPanel {
         external_source_prompt: Option<ExternalSourcePrompt>,
+        /// Open this existing thread instead of starting a new one.
+        ///
+        /// The id is the agent session id, which is what `AgentPanel::open_thread`
+        /// already resolves against `ThreadMetadataStore`. It is deliberately the
+        /// same identifier the agent itself uses, so whatever produced the link --
+        /// a share link, a shell script, a notification -- does not have to know
+        /// anything about Zed's local thread ids.
+        session_id: Option<acp::SessionId>,
     },
     InstallSkill {
         /// Full `SKILL.md` contents embedded in a `zed://skill` share link.
@@ -93,9 +102,11 @@ impl std::fmt::Debug for OpenRequestKind {
                 .finish(),
             Self::AgentPanel {
                 external_source_prompt,
+                session_id,
             } => f
                 .debug_struct("AgentPanel")
                 .field("external_source_prompt", external_source_prompt)
+                .field("session_id", session_id)
                 .finish(),
             Self::InstallSkill { content } => f
                 .debug_struct("InstallSkill")
@@ -221,15 +232,33 @@ impl OpenRequest {
     }
 
     fn parse_agent_url(&mut self, agent_path: &str) {
-        // Format: "" or "?prompt=<text>".
+        // Format: "", "?prompt=<text>" or "?session=<id>".
+        //
+        // The two are mutually exclusive in practice and `session` wins: a link
+        // that names an existing thread is asking for that thread, and seeding a
+        // prompt into it would put words in a conversation the user did not
+        // reopen to extend.
         let agent_path = agent_path.strip_prefix('/').unwrap_or(agent_path);
-        let external_source_prompt = agent_path.strip_prefix('?').and_then(|query| {
-            url::form_urlencoded::parse(query.as_bytes())
-                .find_map(|(key, value)| (key == "prompt").then_some(value))
-                .and_then(|prompt| ExternalSourcePrompt::new(prompt.as_ref()))
+        let query = agent_path.strip_prefix('?');
+
+        let session_id = query.and_then(|query| {
+            url::form_urlencoded::parse(query.as_bytes()).find_map(|(key, value)| {
+                (key == "session" && !value.trim().is_empty())
+                    .then(|| acp::SessionId::new(value.trim()))
+            })
         });
+
+        let external_source_prompt = session_id.is_none().then(|| {
+            query.and_then(|query| {
+                url::form_urlencoded::parse(query.as_bytes())
+                    .find_map(|(key, value)| (key == "prompt").then_some(value))
+                    .and_then(|prompt| ExternalSourcePrompt::new(prompt.as_ref()))
+            })
+        }).flatten();
+
         self.kind = Some(OpenRequestKind::AgentPanel {
             external_source_prompt,
+            session_id,
         });
     }
 
